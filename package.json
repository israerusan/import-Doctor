    "test": "npm run typecheck && node --test tests/*.test.mjs"
  },
  "author": "iavil",
  "license": "MIT",
  "dependencies": {
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "obsidian": "1.7.2",
    "typescript": "^5.8.3"
  }
}
