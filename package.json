{
  "name": "obsidian-import-doctor",
  "version": "0.1.0",
  "description": "Audit and safely repair Notion imports in Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
